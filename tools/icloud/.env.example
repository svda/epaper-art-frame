# Copy to tools/icloud/.env (git-ignored) and fill in. Real environment variables override this file.

# scp destination for push_to_ha.sh: [user@]host:/path/to/config/www/epaper/
EPAPER_DEST=user@host:/path/to/config/www/epaper/

# Photos library to read (default: the system library)
# PHOTOS_LIBRARY=/Users/you/Pictures/Photos Library.photoslibrary

# Photos album to mirror (all photos in it; shared albums supported)
ALBUM=epaper art frame

# launchd sync interval, in hours
SYNC_INTERVAL_H=6

# Artwork folder (default: the profile's folder — www/epaper for the default profile)
# EPAPER_IMAGES=/path/to/artwork

# Which panel to prepare for (default: the default profile, acep565 — the 5.65" frame).
# Set to spectra6-133 for the 13.3" Spectra 6 frame, which also moves the artwork
# folder to www/epaper13. See tools/epaper/profiles.json.
# EPAPER_PROFILE=spectra6-133