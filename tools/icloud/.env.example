# Copy to tools/icloud/.env (git-ignored) and fill in. Real environment variables override this file.

# scp destination for push_to_ha.sh: [user@]host:/path/to/config/www/epaper/
EPAPER_DEST=user@host:/path/to/config/www/epaper/

# Photos library to read (default: the system library)
# PHOTOS_LIBRARY=/Users/you/Pictures/Photos Library.photoslibrary

# How many favorites to keep in the rotation
TOP_N=50

# launchd sync interval, in hours
SYNC_INTERVAL_H=6

# Artwork folder (default: <repo>/www/epaper)
# EPAPER_IMAGES=/path/to/artwork